# Core engine configuration.
#
# On Railway, DATABASE_URL is injected by the Postgres service. Reference it
# from the core-engine service rather than pasting the value, so credential
# rotation does not require a redeploy.

# Local development against the Docker Postgres described in the README.
DATABASE_URL=postgres://cloudopt:devpass@localhost:55432/cloudoptimizer

# Used only by tests, and must name a DIFFERENT database. The schema tests
# delete every tenant, which cascades to clusters, users, and API keys. The
# suite refuses to run if this matches DATABASE_URL.
#   createdb cloudoptimizer_test  (or: docker exec co-postgres psql -U cloudopt -d cloudoptimizer -c "CREATE DATABASE cloudoptimizer_test")
TEST_DATABASE_URL=postgres://cloudopt:devpass@localhost:55432/cloudoptimizer_test

# Set to 1 to echo every SQL statement. Noisy; useful when debugging.
SQL_ECHO=0
