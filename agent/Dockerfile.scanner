# Scanner image: the agent code plus Trivy.
#
# Separate from the agent image on purpose. Trivy and its vulnerability
# database make this an order of magnitude larger, and the agent's security
# argument rests partly on being small and having no reason to pull images.
FROM python:3.12-slim AS build

WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


FROM python:3.12-slim

# Copied from the official image rather than installed via a script, so the
# version is pinned and reproducible and no install script runs as root at
# build time.
COPY --from=aquasec/trivy:0.58.0 /usr/local/bin/trivy /usr/local/bin/trivy

RUN groupadd --system --gid 10001 agent \
 && useradd --system --uid 10001 --gid agent --no-create-home agent

COPY --from=build /install /usr/local
COPY cloudoptimizer_agent /app/cloudoptimizer_agent

WORKDIR /app
USER 10001:10001

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TRIVY_CACHE_DIR=/tmp/trivy \
    TRIVY_NO_PROGRESS=true

ENTRYPOINT ["python", "-m", "cloudoptimizer_agent.scanner"]
